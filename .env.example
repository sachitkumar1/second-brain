# ─── Required ───────────────────────────────────────────────────────────────
# Postgres connection string. Added automatically if you create a Neon/Supabase
# database from Vercel's Storage tab (it may be named POSTGRES_URL — either works).
DATABASE_URL=

# Random secrets. Generate all of these with: npm run secrets
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# ─── Email (sending reminders, alerts and the daily digest) ─────────────────
# Agent mailbox that sends everything, plus a Google "app password" for it.
GMAIL_SENDER=sachitagent29@gmail.com
GMAIL_APP_PASSWORD=
# Default recipient; you can change it any time in Settings → General.
DEFAULT_NOTIFY_EMAIL=sachitkumar2025@gmail.com

# ─── Google: dashboard sign-in + Gmail, Calendar, Drive (one OAuth client) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed to sign in (comma-separated).
ALLOWED_EMAILS=sachitkumar2025@gmail.com,sachitk@berkeley.edu

# ─── AI agent (triage, auto-reminders, digest summary) ──────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=

# ─── Optional ───────────────────────────────────────────────────────────────
# Your name in greetings and AI prompts.
OWNER_NAME=Sachit
# Public URL of the deployment. Vercel sets VERCEL_PROJECT_PRODUCTION_URL, so this
# is only needed if you use a custom domain.
APP_URL=
# Browser/phone push notifications (from: npm run secrets).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
